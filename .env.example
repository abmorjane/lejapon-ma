# Frontend values bundled by Vite. Never place a service-role or secret key here.
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public application URLs.
VITE_PUBLIC_SITE_URL=https://www.lejapon.ma
VITE_SITE_URL=https://www.lejapon.ma
VITE_APP_URL=https://www.lejapon.ma
VITE_APP_ENV=production
VITE_DEPLOY_ENV=production

# Public browser integrations.
VITE_ENABLE_RECAPTCHA=true
VITE_GA_MEASUREMENT_ID=G-WBZK4Q7FTN
VITE_CLARITY_PROJECT_ID=x1qyez2dwm
VITE_VAPID_PUBLIC_KEY=

