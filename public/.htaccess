RewriteEngine On

# Canonical production origin: HTTPS + www.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.lejapon\.ma$ [NC]
RewriteRule ^ https://www.lejapon.ma%{REQUEST_URI} [R=301,L]

# Social crawlers do not reliably execute the React app before reading Open Graph tags.
# Serve a lightweight HTML preview with article-specific meta tags, while keeping the
# canonical URL on /blog/:slug and the normal SPA route for human visitors.
RewriteCond %{HTTP_USER_AGENT} "(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|SkypeUriPreview)" [NC]
RewriteRule ^blog/([^/]+)/?$ https://nkovgpzspprmmhorwaxl.supabase.co/functions/v1/blog-social-preview?slug=$1 [R=302,L,NE]

# Legacy WordPress taxonomy redirects with explicit SEO destinations.
RewriteRule ^tag/visa-japon/?$ /visa-japon-maroc [R=301,L]
RewriteRule ^tag/voyage-japon/?$ /programme [R=301,L]
RewriteRule ^tag/prix-japon/?$ /prix [R=301,L]
RewriteRule ^tag/blog/?$ /blog [R=301,L]
RewriteRule ^tag/japon/?$ /blog [R=301,L]

# Legacy commercial URLs should redirect before the SPA boots.
RewriteRule ^prix/?$ /reserver [R=301,L]
RewriteRule ^inscription/?$ /reserver [R=301,L]
RewriteRule ^paiement/?$ /reserver [R=301,L]

# Secure travel agreement links are handled by React Router.
RewriteRule ^accord-voyage/[^/]+/?$ /index.html [L]

# Old WordPress system/taxonomy URLs that should not resolve to the homepage.
RewriteRule ^wp-content/ - [G,L]
RewriteRule ^wp-json/ - [G,L]
RewriteRule ^feed/?$ - [G,L]
RewriteRule ^category/ - [G,L]
RewriteRule ^author/ - [G,L]
RewriteRule ^tag/ - [G,L]

# React Router fallback.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
