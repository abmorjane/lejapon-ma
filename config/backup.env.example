# Copy these names into a protected environment or GitHub Actions secrets.
# Never commit real values. The examples below are placeholders only.

# PostgreSQL connection obtained from the Supabase production project.
SUPABASE_DB_URL=postgresql://<db-user>:<db-password>@<production-pooler-host>:5432/<database>

# Supabase Storage S3 compatibility credentials with read-only source access.
SUPABASE_BACKUP_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_BACKUP_S3_REGION=<source-region-or-auto>
SUPABASE_BACKUP_S3_PROVIDER=Other
SUPABASE_BACKUP_S3_FORCE_PATH_STYLE=true
SUPABASE_BACKUP_S3_ACCESS_KEY_ID=<source-storage-access-key-id>
SUPABASE_BACKUP_S3_SECRET_ACCESS_KEY=<source-storage-secret-access-key>

# Generic S3-compatible off-site destination.
BACKUP_S3_ENDPOINT=https://<s3-compatible-endpoint>
BACKUP_S3_REGION=<destination-region>
BACKUP_S3_PROVIDER=<rclone-provider-or-Other>
BACKUP_S3_FORCE_PATH_STYLE=<true-or-false>
BACKUP_S3_BUCKET=<private-backup-bucket>
BACKUP_S3_ACCESS_KEY_ID=<destination-access-key-id>
BACKUP_S3_SECRET_ACCESS_KEY=<destination-secret-access-key>

# Independent, high-entropy rclone crypt secrets.
# Preserve both original values in the offline Disaster Recovery vault.
BACKUP_CRYPT_PASSWORD=<high-entropy-encryption-password>
BACKUP_CRYPT_SALT=<independent-high-entropy-salt>

# Optional operational controls.
BACKUP_RETENTION_CLASS=daily
LEJAPON_BACKUP_WORK_ROOT=<encrypted-temporary-volume-outside-the-repository>
SUPABASE_CLI_VERSION=2.117.0
